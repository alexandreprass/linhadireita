# ===== BANCO DE DADOS =====
# Local (SQLite — arquivo na pasta prisma):
DATABASE_URL="file:./linhadireita.db"

# Render (PostgreSQL — dados NÃO somem no redeploy):
# 1) Crie um PostgreSQL no Render
# 2) Cole a Internal Database URL abaixo (começa com postgresql://)
# DATABASE_URL="postgresql://user:pass@host:5432/linhadireita"

# API Grok / xAI — https://console.x.ai
XAI_API_KEY=xai-sua-chave
GROK_MODEL=grok-4.5
# grok-imagine-image (rápido) ou grok-imagine-image-quality (mais fiel)
GROK_IMAGE_MODEL=grok-imagine-image-quality

# Auto: máx. 2 notícias/hora (cron). Manual no admin NÃO tem esse limite.
MAX_REWRITE_PER_CYCLE=2
COLLECT_INTERVAL_MINUTES=60
CRON_SECRET=troque-este-segredo-do-cron

# Máximo de notícias no site (apaga as mais antigas)
MAX_ARTICLES=200

# Admin
ADMIN_USER=admin
ADMIN_PASSWORD=84074070
ADMIN_SESSION_SECRET=troque-por-um-segredo-longo

NEXT_PUBLIC_SITE_URL=http://localhost:3000
