// Banco de dados
// - Local (padrão): SQLite em arquivo (veja DATABASE_URL no .env)
// - Render: use PostgreSQL e DATABASE_URL do painel (dados NÃO somem no redeploy)
//
// Se DATABASE_URL for postgres (começa com postgresql:// ou postgres://),
// o build no Render deve usar provider postgresql — veja scripts/resolve-db.js
generator client {
  provider = "prisma-client-js"
}

datasource db {
  // "sqlite" local | no Render com Postgres o script de build troca para postgresql
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Article {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  lead            String?
  body            String
  category        String   @default("geral")
  tags            String   @default("[]")
  imageUrl        String?
  sourceId        String?
  sourceName      String?
  originalTitle   String?
  originalLink    String?  @unique
  originalSummary String?
  rewriteModel    String?
  featured        Boolean  @default(false)
  status          String   @default("published")
  isManual        Boolean  @default(false)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category])
  @@index([sourceId])
  @@index([featured])
}

model SeenLink {
  link      String   @id
  firstSeen DateTime @default(now())
}

model JobLog {
  id         String    @id @default(cuid())
  kind       String
  status     String
  detail     String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}
